# ════════════════════════════════════════════════════════════
# KPL Dashboard 本機開發環境變數範本
# ════════════════════════════════════════════════════════════
#
# 使用方式：
#   1. 複製此檔為 .env：  cp .env.example .env
#   2. 填入真實值
#   3. 啟動伺服器：       node server.js
#
# ⚠️ 規則：
#   - .env 絕對不要 commit 到 Git（已加入 .gitignore）
#   - 真實的 DB 密碼請向 IT 同仁索取
#   - 正式環境（Cloud Run）的環境變數設在 Cloud Run Console，不靠這個檔案
#
# ════════════════════════════════════════════════════════════

# ── 伺服器基本設定 ──────────────────────────────────
# 本機伺服器埠號（預設 4173）
PORT=4173

# 環境模式（development | production）
# 本機放 development，Cloud Run 會自動帶 K_SERVICE 變數判定為 production
NODE_ENV=development


# ── Cloud SQL 連線設定 ──────────────────────────────
# 完整 Cloud SQL 連線名稱（格式：project:region:instance）
DB_INSTANCE_CONNECTION_NAME=l000-493901:asia-east1:l000-db

# 資料庫名稱
DB_NAME=L000-DB

# 資料庫使用者
DB_USER=L000LDB

# 資料庫密碼（向 IT 索取，不要 commit）
DB_PASSWORD=請填入真實密碼

# Schema 名稱
DB_SCHEMA=kpl_dashboard

# （選用）若不透過 /cloudsql 連線，可指定 host
# DB_HOST=127.0.0.1


# ── 應用程式設定 ────────────────────────────────────
# 超級管理員帳號（小寫，預設 inari）
ADMIN_USER_ID=inari
